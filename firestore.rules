rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function claimTenantId() {
      return request.auth.token.tenantId;
    }
    function claimRole() {
      return request.auth.token.role;
    }
    function isMember(tenantId) {
      return isSignedIn() && claimTenantId() == tenantId;
    }
    function isAdmin(tenantId) {
      return isMember(tenantId) && claimRole() == 'admin';
    }

    match /tenants/{tenantId} {
      allow read: if isMember(tenantId);
      allow write: if isAdmin(tenantId);

      match /members/{memberId} {
        allow read: if isMember(tenantId);
        allow write: if isAdmin(tenantId);
      }

      match /settings/{settingsDoc} {
        allow read: if isMember(tenantId);
        allow write: if isAdmin(tenantId);
      }

      match /materials/{materialId} {
        allow read: if isMember(tenantId);
        allow write: if isAdmin(tenantId);
      }

      match /printers/{printerId} {
        allow read: if isMember(tenantId);
        allow write: if isAdmin(tenantId);
      }

      match /products/{productId} {
        allow read: if isMember(tenantId);
        allow write: if isMember(tenantId);
      }

      match /orders/{orderId} {
        allow read: if isMember(tenantId);
        // `stockDebited` só pode ser alterado pela Server Action (Admin SDK, que
        // ignora estas regras) — na criação tem que nascer `false`, e num update
        // de client não pode mudar de valor.
        allow create: if isMember(tenantId) && request.resource.data.stockDebited == false;
        allow update: if isMember(tenantId)
          && request.resource.data.stockDebited == resource.data.stockDebited;
        allow delete: if isMember(tenantId);
      }

      match /kanbanColumns/{columnId} {
        allow read: if isMember(tenantId);
        allow write: if isAdmin(tenantId);
      }

      match /stockMovements/{movementId} {
        allow read: if isMember(tenantId);
        allow write: if false;
      }
    }

    // Só Server Actions (Admin SDK) tocam pendingInvites — nunca o client.
    match /pendingInvites/{inviteId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
